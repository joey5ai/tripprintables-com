<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta name="robots" content="{% if site.siteIsLive %}index, follow{% else %}noindex, follow{% endif %}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<!-- Open Graph -->
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or site.ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">

<link rel="icon" href="/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">

{% if schema %}
<script type="application/ld+json">{{ schema | dump | safe }}</script>
{% endif %}

<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','{{ site.gtmId }}');</script>
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtmId }}"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<nav class="site-nav">
  <div class="container">
    <a href="/" class="nav-logo">Trip Printables</a>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav-links" id="nav-links">
      <li><a href="/templates/">Templates</a></li>
      <li><a href="/search/">Search</a></li>
      <li><a href="/premium/">Premium Kit</a></li>
      <li><a href="/about/">About</a></li>
      <li><a href="/premium/" class="cta">Get the Kit</a></li>
    </ul>
  </div>
</nav>

<main>
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="container">
    <div>&copy; {{ "now" | year }} Trip Printables. Free travel templates, made to actually get used.</div>
    <div class="footer-links">
      <a href="/templates/">All templates</a>
      <a href="/premium/">Premium Kit</a>
      <a href="/about/">About</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </div>
  </div>
</footer>

<script src="/js/nav.js" defer></script>
</body>
</html>
