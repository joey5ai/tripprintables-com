---
layout: layout.njk
title: "Search Templates: Trip Printables"
description: "Search every travel planning template on Trip Printables, including itineraries, checklists, budgets, and packing lists, to find exactly what you need for your trip."
---
<section class="container search-page">
  <h1>Search templates</h1>
  <p class="lede">Find the itinerary, checklist, or planner you're looking for.</p>
  <div id="pagefind-search"></div>
</section>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet">
<script src="/pagefind/pagefind-ui.js"></script>
<script>
  window.addEventListener("DOMContentLoaded", () => {
    new PagefindUI({ element: "#pagefind-search", showSubResults: true });
  });
</script>

<script type="module">
  // Fire-and-forget query capture, parallel to PagefindUI's own search
  // (internal only per EDITORIAL.md-equivalent standard; never surfaced to
  // readers). Runs its own pagefind.search() call rather than reading
  // PagefindUI's rendered result count, since PagefindUI doesn't expose a
  // search-event hook -- the local index lookup is cheap, so a second call
  // is negligible cost, not a real duplicate-work concern.
  let pagefind;
  let debounceTimer;

  async function logSearch(query, resultsCount) {
    try {
      await fetch("/api/log-search", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query, timestamp: new Date().toISOString(), resultsCount }),
      });
    } catch {
      // best-effort only
    }
  }

  async function handleInput(query) {
    const trimmed = query.trim();
    if (!trimmed) return;
    if (!pagefind) {
      pagefind = await import("/pagefind/pagefind.js");
      await pagefind.init();
    }
    const search = await pagefind.search(trimmed);
    logSearch(trimmed, search.results.length);
  }

  window.addEventListener("DOMContentLoaded", () => {
    document.addEventListener("input", (e) => {
      if (!e.target.matches(".pagefind-ui__search-input")) return;
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => handleInput(e.target.value), 500);
    });
  });
</script>

<style>
  .search-page { padding: 3rem 0 4rem; max-width: 720px; }
  .search-page h1 { margin-bottom: 0.5rem; }
  #pagefind-search {
    margin-top: 2rem;
    --pagefind-ui-primary: var(--teal);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--bg2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: 'DM Sans', sans-serif;
  }
</style>
